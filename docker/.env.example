# 复制为 docker/.env 或项目根 .env 后，把所有 change-me* 换成强随机值。
# 这些变量同时被 compose 与宿主机上的业务服务读取。

# --- PostgreSQL ---
POSTGRES_PASSWORD=change-me
# 宿主机连容器库用 5433（避免与本机 postgres 服务冲突）
POSTGRES_PORT=5433

# --- Redis ---
REDIS_PASSWORD=change-me-redis

# --- Nacos（生产必须启用鉴权后重新生成） ---
NACOS_AUTH_TOKEN=change-me-nacos-token-base64
NACOS_AUTH_IDENTITY_KEY=serverIdentity
NACOS_AUTH_IDENTITY_VALUE=change-me-identity

# --- 业务服务签名密钥（RS256 私钥，PKCS#8 Base64 单行） ---
AUTH_JWT_PRIVATE_KEY=
AUTH_JWT_KEY_ID=lunar-dev-key-1

# --- 评测沙箱 ---
GO_JUDGE_BASE_URL=http://localhost:5050
